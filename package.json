{
  "name": "wireguard-connect-action",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "12.21.0"
  },
  "scripts": {
    "setup-hooks": "node scripts/install-hooks.mts",
    "lint": "pnpm run lint:format && pnpm run lint:spelling && pnpm run lint:types",
    "lint:format": "prettier --check \"**/*.{cjs,json,md,mjs,mts,ts,yaml,yml}\"",
    "lint:spelling": "cspell --config cspell.config.yaml --no-progress \"**/*\"",
    "lint:types": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "build": "ncc build src/main.ts --out dist/main && ncc build src/post.ts --out dist/post",
    "format": "prettier --write \"**/*.{cjs,json,md,mjs,mts,ts,yaml,yml}\""
  },
  "dependencies": {
    "@actions/core": "2.0.3",
    "@actions/exec": "3.0.0",
    "@actions/io": "2.0.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@vercel/ncc": "0.45.0",
    "cspell": "10.5.2",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3"
  }
}
