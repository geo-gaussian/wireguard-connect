{
  "name": "wireguard-connect-action",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": "12.21.0"
  },
  "scripts": {
    "setup-hooks": "node scripts/install-hooks.cjs",
    "lint": "pnpm run lint:format && pnpm run lint:spelling && pnpm run lint:types",
    "lint:format": "prettier --check \"**/*.{cjs,json,md,mjs,ts,yaml,yml}\"",
    "lint:spelling": "cspell --config cspell.config.yaml --no-progress \"**/*\"",
    "lint:types": "tsc --noEmit",
    "test": "jest --runInBand",
    "build": "ncc build src/main.ts --out dist/main",
    "format": "prettier --write \"**/*.{cjs,json,md,mjs,ts,yaml,yml}\""
  },
  "dependencies": {
    "@actions/core": "1.11.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "20.19.9",
    "@vercel/ncc": "0.38.4",
    "cspell": "10.5.2",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3"
  }
}
